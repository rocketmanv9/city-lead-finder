# Copy this file to ".env" and fill in your keys.
# Get an Outscraper key:  https://app.outscraper.com/profile
# Get an OpenAI key:      https://platform.openai.com/api-keys

OUTSCRAPER_API_KEY=your_outscraper_key_here
OPENAI_API_KEY=your_openai_key_here

# --- LLM provider ---
# The tool uses OpenAI by default. To use DeepSeek instead (much cheaper), just add
# DEEPSEEK_API_KEY below — it's auto-selected when present. Force a provider with
# LLM_PROVIDER, and override the model with LLM_MODEL.
# DEEPSEEK_API_KEY=your_deepseek_key_here
# LLM_PROVIDER=deepseek          # openai | deepseek (optional; auto-detected)
# LLM_MODEL=deepseek-chat        # e.g. deepseek-chat, gpt-4o-mini, gpt-4o

# Optional tuning (defaults shown). CLI flags override these.
# OPENAI_MODEL=gpt-4o-mini
# RESULTS_PER_QUERY=20
# LEAD_TYPES=apartment complexes,warehouses,shopping centers

# --- Phase 2: Contact Enrichment Engine (all optional) ---
# Website scraping works with zero keys. Add any of these to enrich further.
# Cheapest-first: website (free) -> Hunter -> Apollo -> Prospeo.
# HUNTER_API_KEY=your_hunter_key_here
# APOLLO_API_KEY=your_apollo_key_here
# PROSPEO_API_KEY=your_prospeo_key_here
# ENRICH_BATCH=5

# --- "Find Me Opportunity" estimator ---
# $/sq ft pavement-maintenance opportunity used to value the pipeline.
# OPPORTUNITY_RATE=0.35
